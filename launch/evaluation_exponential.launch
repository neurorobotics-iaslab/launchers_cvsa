<?xml version="1.0"?>
<launch>

    <!-- ACQUISITION -->
    <!-- arguments -->
        <arg name="plugin"     default='rosneuro::EGDDevice'/>
        <arg name="devarg"     default='eego|EEG_MASK|0xE1FFB760F731C675'/>
        <!-- <arg name="devarg"     default='/home/paolo/prova39ch.gdf'/> -->
        <arg name="framerate"  default='16'/>
        <arg name="samplerate" default='512'/>

    <!-- aquisition node -->
    <node name="acquisition" pkg="rosneuro_acquisition" type="acquisition" output="screen" >
        <param name="~plugin"       value="$(arg plugin)"/>
        <param name="~devarg"       value="$(arg devarg)"/>
        <param name="~samplerate"   value="$(arg samplerate)"/>
        <param name="~framerate"    value="$(arg framerate)"/>
    </node>


    <!-- RECORDER -->
    <!-- arguments recorder -->
        <arg name="autostart" default='true'/>
        <arg name="subject"   default="c7"/> <!-- depends on the user -->
        <arg name="filepath"  default='/home/paolo/cvsa/ic_cvsa_ws/record/$(arg subject)' />
    <!-- arguments protocol -->
        <arg name="task"      default="cvsa_lbrb"/>
        <arg name="extra"     default=""/>
        <arg name="modality"  default='evaluation'/>

    <!-- parameters parameters -->
        <rosparam param="/protocol/subject"     subst_value="True">$(arg subject)</rosparam>
        <rosparam param="/protocol/modality"    subst_value="True">$(arg modality)</rosparam>
        <rosparam param="/protocol/task"        subst_value="True">$(arg task)</rosparam>
        <rosparam param="/protocol/extra"       subst_value="True">$(arg extra)</rosparam>

    <!-- node -->
    <node name="recorder" pkg="rosneuro_recorder" type="recorder" >
        <param name="~autostart" value="$(arg autostart)"/>
        <param name="~filepath" value="$(arg filepath)"/>
    </node>


    <!-- IMU node-->
    <arg name="imu" default="false"/>
    <group if="$(arg imu)">
        <node name="imu_cvsa_node" pkg="imu_cvsa" type="imu_cvsa_node" output="screen"/>
    </group>    


    <!-- EYE_DECODER, CALIBRATION AND CAMERA -->
    <arg name="eye_detection" default='false'/>
    <arg name="realsense_camera" default='false'/>
    <arg name="eye_motion_online" default='false'/> <!-- Check the eye motion online -->
    <group if="$(arg eye_detection)">
        <!-- arguments -->
            <arg name="cam_source"                  default='0'/> <!-- 0 for internal webcam, 4 for external webcam -->
            <arg name="blink_threshold"             default='0.52'/>
            <arg name="rate"                        default='256'/>
            <arg name="show_frame"                  default='False'/>

         <!-- Realsense camera node -->
        <group if="$(arg realsense_camera)">
            <include file="$(find realsense2_camera)/launch/rs_camera.launch" >
                <arg name="initial_reset"    value="true"/>
                <arg name="enable_depth"     value="false"/>
            </include>
        </group>

        <!-- Eye decoder node -->
        <node name="eye_decoder" pkg="eye_decoder" type="eye_decoder_node.py" output="screen" >
            <param name="realsense_camera"    type="bool"              value="$(arg realsense_camera)"/>
            <param name="cam_source"          type="int"               value="$(arg cam_source)"  if="$(eval not realsense_camera)" />
            <param name="rate"                type="int"               value="$(arg rate)"/>
            <param name="show_frame"          type="bool"              value="$(arg show_frame)"/>
            <param name="blink_threshold"     type="double"            value="$(arg blink_threshold)"/>
        </node>

        <!-- Eye calibration online node -->
        <group if="$(arg eye_motion_online)">
            <node pkg="eye_motion_online" type="online_eye_node" name="online_eye_node" output="screen">
                <rosparam param="classes"  subst_value="True">$(arg calibration_classes)</rosparam>
                <rosparam param="th_frame" subst_value="True">$(arg th_frame)</rosparam>
            </node>
        </group>
    </group>


    <!-- PROCESSING -->
    <rosparam command="load" file="$(find test_pipeline)/cfg/ringbuffer.yaml"/>
    <arg name="nchannels" default='39'/>
    <arg name="chunkSize" default='32'/>
    <arg name="execution_mode" default='online'/> <!-- offline / online -->
    <arg name="filter_order" default='4'/>
    <arg name='filters_band' default='8.0 14.0;'/>

    <!-- node -->
    <node name="processing_cvsa_node" pkg="processing_cvsa" type="processing_cvsa_node" output="screen"> 
        <param name="nchannels"   value="$(arg nchannels)"/>
        <param name="chunkSize"       value="$(arg chunkSize)"/>
        <param name="samplerate"  value='$(arg samplerate)'/>
        <param name="filter_order" value="$(arg filter_order)"/>
        <param name="modality" value="$(arg execution_mode)"/>
        <param name="filters_band"           value="$(arg filters_band)"/>
    </node>


    <!-- ARTIFACTS -->
    <!-- arguments -->
    <rosparam command="load" file="$(find test_pipeline)/cfg/artifact.yaml"/>

    <!-- node -->
    <node name="artifactDetector_node" pkg="artifacts_cvsa" type="artifactDetector_node" output="screen"> 
        <param name="nchannels"   value="$(arg nchannels)"/>
        <param name="chunkSize"       value="$(arg chunkSize)"/>
        <param name="modality" value="$(arg execution_mode)"/>
    </node>


    <!-- ICNIC (GMM) -->
    <!-- arguments -->
    <arg name="path_gmm_model" default='$(find gmm_cvsa)/cfg/gmm_c7_26112025_102244.yaml'/> 

    <!-- node -->
    <node name="gmm_node" pkg="gmm_cvsa" type="gmm.py" output="screen"> 
        <param name="path_gmm_model"   value="$(arg path_gmm_model)"/>
    </node>


    <!-- CLASSIFIER RAW (QDA)-->
    <!-- arguments -->
    <arg name="path_qda_model" default='$(find qda_cvsa)/cfg/qda_c7_20112025_152158.yaml'/> 

    <!-- node -->
    <node name="qda_node" pkg="qda_cvsa" type="qda.py" output="screen"> 
        <param name="path_qda_model"   value="$(arg path_qda_model)"/>
    </node>


    <!-- INTEGRATOR -->
    <!-- arguments -->
    <arg name="classes"          default='[730, 731]'/>
    <arg name="init_percentual"  default="[0.5,0.5]" />
    <arg name="ic_threshold" default='0.7'/>
    <arg name="ic_class_label" default='1'/> 
    <arg name="thresholds_rejection" default="[0.5, 0.5]" /> 
    <!-- exponential -->
    <arg name="plugin_integrator" default='rosneuro::integrator::Exponential'/>
    <arg name="alpha" default="0.98"/>
    <node name="integrator" pkg="rosneuro_integrator" type="integrator" output="screen" >
        <param name="plugin" 	               value="$(arg plugin_integrator)"/>
        <rosparam param="init_percentual" subst_value="True">$(arg init_percentual)</rosparam>
        <rosparam param="alpha"                subst_value="true">$(arg alpha)</rosparam> 
        <rosparam param="thresholds_rejection" subst_value="true">$(arg thresholds_rejection)</rosparam>
        <param name="ic_threshold"       value="$(arg ic_threshold)"/>
        <param name="ic_class_label"       value="$(arg ic_class_label)"/>
    </node>
    

    <!-- FEEDBACK -->
    <!-- visual and audio feedback arguments -->
        <arg name="thresholds"       default='[0.7, 0.7]'/> <!-- depends on the user -->
        <arg name="trials"           default='[10, 10]'/>
        <!--arg name="circlePositions"  default="-1.3 -0.75; 1.3 -0.75; 0.0 0.65"/-->
        <arg name="circlePositions"  default="-1.65 -0.8; 1.65 -0.8"/>
        <!--arg name="circlePositions"  default="-1.3 -0.75; 1.3 -0.75; -1.3 0.85; 1.3 0.85"/-->
        <arg name="audio_path"       default="$(find feedback_cvsa)/cfg"/>
        <arg name="robot_control"    default='False'/>
        <arg name="audio_cue"        default='True'/>
        <arg name="eye_calibration"  default='False'/> <!-- eye calibration will not start -->
    
    <!-- positive feedback arguments -->
        <arg name="positive_feedback" default='False'/>

    <!-- eye calibration arguments -->
        <arg name="th_frame"               default='3'/>
        <arg name="calibration_positions"  default="0.0 0.0; 
                                 -1.65 -0.8;
                                                     1.65 -0.8;
                                                     0.0 -0.8;
                                                    -1.65 0.0;
                                                     1.65 0.0;
                                                    -1.65 0.9;
                                                     1.65 0.9;
                                                     0.0  0.9"/> <!-- always 0.0 0.0 with 735 as first elem -->
        <arg name="calibration_classes"     default='[735,730,731,732,733,734,736,737,738]'/>
        <arg name="max_trials_per_class"    default='[15, 15]'/>

    <!-- node -->
    <node name="trainingCVSA_node" pkg="feedback_cvsa" type="trainingCVSA_node"  output="screen">
        <rosparam param="modality"              subst_value="True">$(arg modality)</rosparam>
        <rosparam param="thresholds"            subst_value="True">$(arg thresholds)</rosparam>
        <rosparam param="classes"               subst_value="True">$(arg classes)</rosparam>
        <rosparam param="trials"                subst_value="True">$(arg trials)</rosparam>
        <rosparam param="circlePositions"       subst_value="True">$(arg circlePositions)</rosparam>
        <rosparam param="eye_calibration"       subst_value="True">$(arg eye_calibration)</rosparam>
        <rosparam param="calibration_positions" subst_value="True">$(arg calibration_positions)</rosparam>
        <rosparam param="calibration_classes"   subst_value="True">$(arg calibration_classes)</rosparam> 
        <rosparam param="max_trials_per_class"  subst_value="True">$(arg max_trials_per_class)</rosparam> 
        <rosparam param="audio_path"            subst_value="True">$(arg audio_path)</rosparam>
        <rosparam param="positive_feedback"     subst_value="True">$(arg positive_feedback)</rosparam>
        <rosparam param="init_percentual"       subst_value="True">$(arg init_percentual)</rosparam>
        <rosparam param="robot_control"         subst_value="True">$(arg robot_control)</rosparam>
        <rosparam param="audio_cue"             subst_value="True">$(arg audio_cue)</rosparam>
        <rosparam param="eye_motion_online"     subst_value="True">$(arg eye_motion_online)</rosparam>
        <rosparam param="eye_detection"         subst_value="True">$(arg eye_detection)</rosparam>
        <rosparam param="imu"                   subst_value="True">$(arg imu)</rosparam>
    </node>


    <!-- ROSBAG -->
    <node pkg="bag_cvsa" type="save_bag.py" name="save_bag" output="screen">
        <rosparam param="filepath" subst_value="True">$(arg filepath)</rosparam>
        <rosparam param="subject"  subst_value="True">$(arg subject)</rosparam>
    </node>


    <!-- UR CONTROL --> <!-- it runs on another pc -->
    <!-- node -->
    <!--node pkg="ur_cvsa" type="ur_cvsa_node" name="ur_cvsa_node" if="$(arg robot_control)" output="screen">
        <rosparam param="classes" subst_value="True">$(arg classes)</rosparam>
    </node-->
    

</launch>
