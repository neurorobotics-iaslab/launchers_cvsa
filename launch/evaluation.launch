<launch>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- TOP-LEVEL CONFIGURATION                                            -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="paradigm" default="cvsa"/>      <!-- mi | cvsa | hybrid -->
    <arg name="subject"  default="c7"/>
    <arg name="extra"    default=""/>
    <arg name="modality" default="evaluation"/>
    <arg name="trials"   default="[10, 10]"/>

    <arg name="classes" value="$(eval '[769, 770]' if arg('paradigm') == 'mi' else
                         ('[750, 751]' if arg('paradigm') == 'hybrid' else
                         ('[730, 731]' if arg('paradigm') == 'cvsa' else 'error_paradigm')))"/>
    <arg name="task" value="$(eval 'mi_lhrh' if arg('paradigm') == 'mi' else
                       ('hybrid_lr' if arg('paradigm') == 'hybrid' else
                       ('cvsa_blbr' if arg('paradigm') == 'cvsa' else 'error_paradigm')))"/>
    <arg name="filepath" default="/home/paolo/bci_vr_ws/recordings/$(arg subject)/$(arg modality)"/>

    <!-- Protocol parameters read by the recorder + downstream nodes -->
    <rosparam param="/protocol/subject"  subst_value="True">$(arg subject)</rosparam>
    <rosparam param="/protocol/modality" subst_value="True">$(arg modality)</rosparam>
    <rosparam param="/protocol/task"     subst_value="True">$(arg task)</rosparam>
    <rosparam param="/protocol/extra"    subst_value="True">$(arg extra)</rosparam>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- ACQUISITION  (LSL → /neurodata)                                    -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="samplerate"  default="500"/>
    <arg name="framerate"   default="20"/>
    <arg name="chunkSize"   default="$(eval int(arg('samplerate') / arg('framerate')))"/>
    <arg name="nchannels"   default="32"/>
    <arg name="stream_name" default="LiveAmpSN-054211-0242"/>
    <arg name="stream_type" default="EEG"/>

    <node name="acquisition" pkg="rosneuro_acquisition" type="acquisition" output="screen"
          launch-prefix="bash -c 'sleep 2; $0 $@'">
        <param name="~plugin"      value="rosneuro::LSLDevice"/>
        <param name="~samplerate"  value="$(arg samplerate)"/>
        <param name="~framerate"   value="$(arg framerate)"/>
        <param name="~stream_type" value="$(arg stream_type)"/>
        <param name="~stream_name" value="$(arg stream_name)"/>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- SHARED PROCESSING CONFIGURATION                                    -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="run_mode"     default="online"/>
    <arg name="signal_type"  default="eeg"/>
    <arg name="filter_order" default="4"/>
    <arg name="do_ica"       default="false"/>
    <arg name="do_car"       default="true"/>
    <arg name="EOG_ch_names"  default='[Fp1, Fp2]'/>

    <rosparam command="load" file="$(find rosneuro_filters_car)/cfg/car.yaml" subst_value="true" if="$(arg do_car)"/>
    <rosparam command="load" file="$(find processing_bci)/cfg/ringbuffer.yaml" subst_value="true"/>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- PROCESSING — MI   (active for paradigm = mi | hybrid)              -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="path_csp_mi"     default="$(find processing_bci)/cfg/csp/mi/csp_c7_27052026_163529.yaml"/>
    <arg name="filters_band_mi" default="8.0 12.0; 10.0 14.0; 12.0 16.0; 14.0 18.0; 16.0 22.0; 20.0 30.0;"/>

    <node name="processing_fbcsp_mi" pkg="processing_bci" type="processing_fbcsp_node"
          output="screen" if="$(eval arg('paradigm') in ['mi', 'hybrid'])">
        <rosparam command="load" file="$(arg path_csp_mi)"/>
        <param name="nchannels"    value="$(arg nchannels)"/>
        <param name="chunkSize"    value="$(arg chunkSize)"/>
        <param name="samplerate"   value="$(arg samplerate)"/>
        <param name="filter_order" value="$(arg filter_order)"/>
        <param name="run_mode"     value="$(arg run_mode)"/>
        <param name="signal_type"  value="$(arg signal_type)"/>
        <param name="filters_band" value="$(arg filters_band_mi)"/>
        <param name="do_ica"       value="$(arg do_ica)"/>
        <param name="do_car"       value="$(arg do_car)"/>
        <param name="paradigm"     value="mi"/>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- PROCESSING — CVSA  (active for paradigm = cvsa | hybrid)           -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="path_csp_cvsa"     default="$(find processing_bci)/cfg/csp/cvsa/csp_c7_27052026_164544.yaml"/>
    <arg name="filters_band_cvsa" default="7.0 11.0; 9.0 13.0; 11.0 15.0;"/>

    <node name="processing_fbcsp_cvsa" pkg="processing_bci" type="processing_fbcsp_node"
          output="screen" if="$(eval arg('paradigm') in ['cvsa', 'hybrid'])">
        <rosparam command="load" file="$(arg path_csp_cvsa)"/>
        <param name="nchannels"    value="$(arg nchannels)"/>
        <param name="chunkSize"    value="$(arg chunkSize)"/>
        <param name="samplerate"   value="$(arg samplerate)"/>
        <param name="filter_order" value="$(arg filter_order)"/>
        <param name="run_mode"     value="$(arg run_mode)"/>
        <param name="signal_type"  value="$(arg signal_type)"/>
        <param name="filters_band" value="$(arg filters_band_cvsa)"/>
        <param name="do_ica"       value="$(arg do_ica)"/>
        <param name="do_car"       value="$(arg do_car)"/>
        <param name="paradigm"     value="cvsa"/>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- ARTIFACT DETECTION                                               -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <rosparam command="load" file="$(find artifacts_bci)/cfg/artifact.yaml"/>
    <arg name="art_bufsize" default="$(eval int(arg('samplerate') / 2))"/>
    <rosparam command="load" file="$(find artifacts_bci)/cfg/ringbuffer.yaml" subst_value="true"/>
    <node name="artifactDetector_node" pkg="artifacts_bci" type="artifactDetector_node" output="screen"/>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- CLASSIFIERS  (sLDA, paradigm-conditional)                          -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="path_slda_model_mi"   default="$(find slda_bci)/models/mi/slda_c7_27052026_163529.yaml"/>
    <arg name="path_slda_model_cvsa" default="$(find slda_bci)/models/cvsa/slda_c7_27052026_164544.yaml"/>

    <node name="slda_node_mi" pkg="slda_bci" type="slda.py" output="screen"
          if="$(eval arg('paradigm') in ['mi', 'hybrid'])">
        <param name="path_slda_model" value="$(arg path_slda_model_mi)"/>
        <param name="topic_sub"       value="/mi/eeg_fbcsp"/>
        <param name="paradigm"        value="mi"/>
    </node>

    <node name="slda_node_cvsa" pkg="slda_bci" type="slda.py" output="screen"
          if="$(eval arg('paradigm') in ['cvsa', 'hybrid'])">
        <param name="path_slda_model" value="$(arg path_slda_model_cvsa)"/>
        <param name="topic_sub"       value="/cvsa/eeg_fbcsp"/>
        <param name="paradigm"        value="cvsa"/>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- INTEGRATOR  (Bayesian fusion for hybrid; leaky-WTA buffer plugin)  -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="plugin_integrator" default="rosneuro::integrator::Buffer"/>
    <arg name="bufferSize"        default="50"/>          <!-- samples; 40 / 20Hz = 2 s response -->
    <arg name="n_classes"         value="$(eval len(eval(arg('classes'))))"/>
    <arg name="k_gain"            default="2.0"/>
    <arg name="init_val"          default="[0.5, 0.5]"/>
    <arg name="thresholds"        default="[0.95, 0.75]"/>
    <arg name="cvsa_influence"    default="4.0"/>
    <arg name="cvsa_hold"         default="1.0"/>

    <node name="integrator" pkg="rosneuro_integrator" type="integrator" output="screen">
        <param name="plugin"      value="$(arg plugin_integrator)"/>
        <rosparam param="thresholds" subst_value="True">$(arg thresholds)</rosparam>
        <rosparam param="init_val"   subst_value="True">$(arg init_val)</rosparam>
        <rosparam param="classes"    subst_value="True">$(arg classes)</rosparam>
        <param name="buffer_size" value="$(arg bufferSize)"/>
        <param name="paradigm"    value="$(arg paradigm)"/>
        <param name="k_gain"      value="$(arg k_gain)"/>
        <param name="n_classes"   value="$(arg n_classes)"/>
        <param name="cvsa_influence" value="$(arg cvsa_influence)"/>
        <param name="cvsa_hold"      value="$(arg cvsa_hold)"/>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- FEEDBACK PROTOCOL  (training_node, evaluation modality)            -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <node name="training_node" pkg="feedback_bci_vr" type="training_node" output="screen">
        <rosparam param="modality"    subst_value="True">$(arg modality)</rosparam>
        <rosparam param="classes"     subst_value="True">$(arg classes)</rosparam>
        <rosparam param="trials"      subst_value="True">$(arg trials)</rosparam>
        <rosparam param="paradigm"    subst_value="True">$(arg paradigm)</rosparam>
        <rosparam param="thresholds"  subst_value="True">$(arg thresholds)</rosparam>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- VR (Unity scene + ROS-TCP bridge)                                  -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <node name="scene_manager" pkg="feedback_bci_vr" type="scene_manager.py" output="screen">
        <param name="paradigm" value="$(arg paradigm)"/>
    </node>

    <arg name="tcp_ip"   default="10.9.2.20"/>
    <arg name="tcp_port" default="10000"/>
    <include file="$(find ros_tcp_endpoint)/launch/endpoint.launch">
        <arg name="tcp_ip"   value="$(arg tcp_ip)"/>
        <arg name="tcp_port" value="$(arg tcp_port)"/>
    </include>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- RECORDER  (GDF)                                                    -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <arg name="autostart" default="true"/>
    <node name="recorder" pkg="rosneuro_recorder" type="recorder">
        <param name="~autostart" value="$(arg autostart)"/>
        <param name="~filepath"  value="$(arg filepath)"/>
    </node>


    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- BAG RECORDER  (paradigm-aware ROS bag + param snapshot)            -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <node name="bag_node" pkg="bag_bci" type="save_bag.py" output="screen">
        <param name="~subject"  value="$(arg subject)"/>
        <param name="~paradigm" value="$(arg paradigm)"/>
        <param name="~modality" value="$(arg modality)"/>
        <param name="~filepath" value="$(arg filepath)"/>
    </node>

</launch>
