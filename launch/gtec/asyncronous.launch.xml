<launch>
    <!-- Classification pipeline running against a live g.tec g.USBamp:
         acquisition(gusbamp) -> filters -> buffer -> decoder -> integrator,
         with a parallel filters_blink -> blink_detector tap watching for
         blink artifacts and publishing onset/offset events on /neuroevent
         (see filters_gtec.launch.xml and
         ros2neuro_artifact_blink/README.md); it does not gate the
         prediction stream, the integrator keeps running through a blink;
         game_controller's threshold controllers suppress outgoing
         /game/command while the published window is open instead. Ends by
         publishing /integrated/raw (two per-class values, see
         game_controller/README.md). Same chain as
         gdf/asyncronous.launch.xml, with the acquisition node swapped for
         the g.USBamp backend (see
         ros2neuro_acquisition_gusbamp/config/gusbamp_configuration.yaml).

         Included by control.launch.py (the asynchronous/continuous game
         control path), not meant to be launched on its own. See
         evaluation_pipeline.launch.xml (same chain, for evaluation) and
         calibration_pipeline.launch.xml (no classifier needed) for the
         other two variants.

         NOTE: acquisition.sensors.eeg.labels below is the 16-channel motor
         cortex montage from gusbamp_configuration.yaml, not the 32-channel
         montage the currently trained model (eegnet_mi_paolo) was trained
         on: update it to match whatever montage is actually wired into
         the amp before running this against a real decoder.

         NOTE: this montage has no true frontal electrode pair; blink_detector
         requires exactly 2 artifact_channels (it averages them), so Fz (the
         most anterior channel available) is listed twice below as a
         degenerate single-channel proxy, weaker than a real FP1/FP2 pair.
         If you wire in dedicated FP1/FP2 (or EOG) channels, point
         artifact_channels at those two instead (by label if set in
         acquisition.sensors.eeg.labels, or by numeric index).
    -->
    <arg name="device" default=""/>
    <arg name="channels" default="16"/>
    <arg name="decoder_model_path" default="/home/paolo/Cortical_Peaks_Challenge_2026/scripts/outputs/eegnet_mi_paolo"/>
    <arg name="samplerate" default="512"/>
    <arg name="framerate" default="16.0"/>
    <arg name="artifact_channels" default="[Fz, Fz]"/>
    <arg name="freeze_duration_sec" default="1.0"/>
    <arg name="threshold_vertical" default="4.0"/>
    <arg name="threshold_horizontal" default="4.0"/>

    <include file="$(find-pkg-share launchers_bci)/launch/gtec/acquisition_gtec.launch.xml">
        <arg name="device" value="$(var device)"/>
        <arg name="channels" value="$(var channels)"/>
        <arg name="samplerate" value="$(var samplerate)"/>
        <arg name="framerate" value="$(var framerate)"/>
    </include>

    <include file="$(find-pkg-share launchers_bci)/launch/gtec/filters_gtec.launch.xml">
        <arg name="samplerate" value="$(var samplerate)"/>
        <arg name="filters_lp_cutoff" value="14.0"/>
        <arg name="artifact_channels" value="$(var artifact_channels)"/>
        <arg name="freeze_duration_sec" value="$(var freeze_duration_sec)"/>
        <arg name="threshold_vertical" value="$(var threshold_vertical)"/>
        <arg name="threshold_horizontal" value="$(var threshold_horizontal)"/>
    </include>

    <node pkg="ros2neuro_processing_buffer" exec="buffer_node" name="buffer" output="screen">
        <param name="sensor_name" value="EEG"/>
        <param name="buffer_samples" value="500"/>
        <remap from="/neurodata_filtered" to="/processing/filtered"/>
        <remap from="/features" to="/processing/buffered_features"/>
    </node>

    <node pkg="ros2neuro_decoder_py" exec="decoder_node" name="decoder" output="screen">
        <param name="decoder.type" value="braindecode"/>
        <param name="decoder.model_path" value="$(var decoder_model_path)"/>
        <param name="decoder.name" value="eegnet_bhbf"/>
        <remap from="/features" to="/processing/buffered_features"/>
        <remap from="~/prediction" to="/classification/prediction"/>
    </node>

    <node pkg="ros2neuro_integrator" exec="integrator_node" name="integrator" output="screen">
        <param name="input_topic" value="/classification/prediction"/>
        <param name="output_topic" value="/integrated/raw"/>
        <param name="integrator.name" value="mi_buffer_integrator"/>
        <param name="integrator.type" value="ros2neuro::integrator::Buffer"/>
        <param name="integrator.params.buffer_size" value="256"/>
        <param name="integrator.params.increment" value="1"/>
    </node>
</launch>
