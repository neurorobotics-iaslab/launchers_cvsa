<launch>
    <!-- Classification pipeline running against a live g.tec g.USBamp:
         acquisition(gusbamp) -> filters -> buffer -> decoder -> integrator.
         Ends by publishing /integrated/raw (two per-class values, see
         game_controller/README.md). Same chain as gdf/asyncronous.launch.xml,
         with the acquisition node swapped for the g.USBamp backend (see
         ros2neuro_acquisition_gusbamp/config/gusbamp_configuration.yaml).

         Included by control.launch.py (the asynchronous/continuous game
         control path), not meant to be launched on its own. See
         evaluation_pipeline.launch.xml (same chain, for evaluation) and
         calibration_pipeline.launch.xml (no classifier needed) for the
         other two variants.

         NOTE: acquisition.sensors.eeg.labels below is the 16-channel motor
         cortex montage from gusbamp_configuration.yaml, not the 32-channel
         montage the currently trained model (eegnet_mi_paolo) was trained
         on: update it to match whatever montage is actually wired into
         the amp before running this against a real decoder.
    -->
    <arg name="device" default=""/>
    <arg name="channels" default="16"/>
    <arg name="decoder_model_path" default="/home/paolo/Cortical_Peaks_Challenge_2026/scripts/outputs/eegnet_mi_paolo"/>
    <arg name="samplerate" default="512"/>
    <arg name="framerate" default="16.0"/>

    <node pkg="ros2neuro_acquisition" exec="acquisition" name="acquisition" output="screen">
        <param name="acquisition.plugin" value="ros2neuro::acquisition::GUSBampDevice"/>
        <param name="acquisition.autostart" value="true"/>
        <param name="acquisition.reopen" value="true"/>
        <param name="acquisition.samplerate" value="$(var samplerate)"/>
        <param name="acquisition.framerate" value="$(var framerate)"/>
        <param name="acquisition.device" value="$(var device)"/>
        <param name="acquisition.channels" value="$(var channels)"/>
        <param name="acquisition.enable_trigger_line" value="true"/>
        <param name="acquisition.scan_dio" value="true"/>
        <param name="acquisition.slave_mode" value="false"/>
        <param name="acquisition.enable_sc" value="false"/>
        <param name="acquisition.bandpass_filter" value="-1"/>
        <param name="acquisition.notch_filter" value="-1"/>
        <param name="acquisition.bipolar_derivation" value="-2"/>
        <param name="acquisition.sensors.eeg.enable" value="true"/>
        <param name="acquisition.sensors.eeg.name" value="EEG"/>
        <param name="acquisition.sensors.eeg.labels" value="[Fz, FC3, FC1, FCz, FC2, FC4, C3, C1, Cz, C2, C4, CP3, CP1, CPz, CP2, CP4]"/>
        <param name="acquisition.triggers.trigger.enable" value="true"/>
        <param name="acquisition.triggers.trigger.name" value="TRI"/>
    </node>

    <node pkg="ros2neuro_filters" exec="filter_chain_node" name="filters" output="screen">
        <param name="filters.chain" value="[hp, lp]"/>
        <param name="filters.hp.class" value="ros2neuro_filters_butterworth/ButterworthFloat"/>
        <param name="filters.hp.order" value="2"/>
        <param name="filters.hp.samplerate" value="$(var samplerate)"/>
        <param name="filters.hp.cutoff" value="4.0"/>
        <param name="filters.hp.type" value="highpass"/>
        <param name="filters.lp.class" value="ros2neuro_filters_butterworth/ButterworthFloat"/>
        <param name="filters.lp.order" value="2"/>
        <param name="filters.lp.samplerate" value="$(var samplerate)"/>
        <param name="filters.lp.cutoff" value="14.0"/>
        <param name="filters.lp.type" value="lowpass"/>
        <remap from="/neurodata" to="/acquisition/neurodata"/>
        <remap from="~/filtered" to="/processing/filtered"/>
    </node>

    <node pkg="ros2neuro_processing_buffer" exec="buffer_node" name="buffer" output="screen">
        <param name="sensor_name" value="EEG"/>
        <param name="buffer_samples" value="500"/>
        <remap from="/neurodata_filtered" to="/processing/filtered"/>
        <remap from="/features" to="/processing/buffered_features"/>
    </node>

    <node pkg="ros2neuro_decoder_py" exec="decoder_node" name="decoder" output="screen">
        <param name="decoder.type" value="braindecode"/>
        <param name="decoder.model_path" value="$(var decoder_model_path)"/>
        <param name="decoder.name" value="eegnet_bhbf"/>
        <remap from="/features" to="/processing/buffered_features"/>
        <remap from="~/prediction" to="/classification/prediction"/>
    </node>

    <node pkg="ros2neuro_integrator" exec="integrator_node" name="integrator" output="screen">
        <param name="input_topic" value="/classification/prediction"/>
        <param name="output_topic" value="/integrated/raw"/>
        <param name="integrator.name" value="mi_buffer_integrator"/>
        <param name="integrator.type" value="ros2neuro::integrator::Buffer"/>
        <param name="integrator.params.buffer_size" value="256"/>
        <param name="integrator.params.increment" value="1"/>
    </node>
</launch>
