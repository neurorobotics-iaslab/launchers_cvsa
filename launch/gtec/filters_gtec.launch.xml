<launch>
    <!-- Shared filtering + blink-detection chain for the live g.tec g.USBamp
         backend: filters (MI band) plus a parallel filters_blink ->
         blink_detector tap (see ros2neuro_artifact_blink/README.md) that
         publishes onset/offset events on /neuroevent without touching the
         prediction stream. Identical across evaluation_pipeline.launch.xml
         and asyncronous.launch.xml except for the main filter's lowpass
         cutoff and the artifact_channels montage, both exposed as args, so
         it lives here once and each of the two includes it instead of
         redeclaring the three <node>s. Not used by
         calibration_pipeline.launch.xml (no classifier there, so no blink
         gating needed; see its own comment).
    -->
    <arg name="samplerate" default="512"/>
    <arg name="filters_lp_cutoff" default="14.0"/>
    <arg name="artifact_channels" default="[FP1, FP2]"/>
    <arg name="freeze_duration_sec" default="1.0"/>
    <arg name="threshold_vertical" default="4.0"/>
    <arg name="threshold_horizontal" default="4.0"/>

    <node pkg="ros2neuro_filters" exec="filter_chain_node" name="filters" output="screen">
        <param name="filters.chain" value="[hp, lp]"/>
        <param name="filters.hp.class" value="ros2neuro_filters_butterworth/ButterworthFloat"/>
        <param name="filters.hp.order" value="2"/>
        <param name="filters.hp.samplerate" value="$(var samplerate)"/>
        <param name="filters.hp.cutoff" value="4.0"/>
        <param name="filters.hp.type" value="highpass"/>
        <param name="filters.lp.class" value="ros2neuro_filters_butterworth/ButterworthFloat"/>
        <param name="filters.lp.order" value="2"/>
        <param name="filters.lp.samplerate" value="$(var samplerate)"/>
        <param name="filters.lp.cutoff" value="$(var filters_lp_cutoff)"/>
        <param name="filters.lp.type" value="lowpass"/>
        <remap from="/neurodata" to="/acquisition/neurodata"/>
        <remap from="~/filtered" to="/processing/filtered"/>
    </node>

    <!-- Second, independent tap on the same raw acquisition, filtered to a
         band that keeps blink content (blinks are ~1-3 Hz and are removed
         by the hp filter above, used for MI classification). -->
    <node pkg="ros2neuro_filters" exec="filter_chain_node" name="filters_blink" output="screen">
        <param name="filters.chain" value="[hp, lp]"/>
        <param name="filters.hp.class" value="ros2neuro_filters_butterworth/ButterworthFloat"/>
        <param name="filters.hp.order" value="2"/>
        <param name="filters.hp.samplerate" value="$(var samplerate)"/>
        <param name="filters.hp.cutoff" value="1.0"/>
        <param name="filters.hp.type" value="highpass"/>
        <param name="filters.lp.class" value="ros2neuro_filters_butterworth/ButterworthFloat"/>
        <param name="filters.lp.order" value="2"/>
        <param name="filters.lp.samplerate" value="$(var samplerate)"/>
        <param name="filters.lp.cutoff" value="10.0"/>
        <param name="filters.lp.type" value="lowpass"/>
        <remap from="/neurodata" to="/acquisition/neurodata"/>
        <remap from="~/filtered" to="/processing/filtered_blink"/>
    </node>

    <!-- Watches filters_blink's output and publishes onset/offset events on
         /neuroevent; it does NOT touch the prediction stream, so the
         integrator downstream keeps integrating right through a blink.
         Downstream consumers (training_controller in evaluation,
         game_controller's threshold controllers in the async/control path)
         suppress outgoing behavior while the published window is open
         instead. blink_detector withholds detection until it has a matched
         /neuroevent subscriber (see its README), so it never publishes
         before that subscriber is up. -->
    <node pkg="ros2neuro_artifact_blink" exec="blink_detector_node" name="blink_detector" output="screen">
        <param name="sensor_name" value="EEG"/>
        <param name="artifact_channels" value="$(var artifact_channels)"/>
        <param name="freeze_duration_sec" value="$(var freeze_duration_sec)"/>
        <param name="threshold_vertical" value="$(var threshold_vertical)"/>
        <param name="threshold_horizontal" value="$(var threshold_horizontal)"/>
        <remap from="/neurodata_filtered" to="/processing/filtered_blink"/>
    </node>
</launch>
