<launch>
    <!-- Classification pipeline against a live g.tec g.USBamp: acquisition
         (gusbamp) -> filters -> buffer -> decoder -> integrator, with a
         parallel filters_blink -> blink_detector tap watching for blink
         artifacts and publishing onset/offset events on /neuroevent (see
         filters_gtec.launch.xml and ros2neuro_artifact_blink/README.md); it
         does not gate the prediction stream, the integrator keeps running
         through a blink; training_controller (in evaluation modality)
         tracks the window from /neuroevent instead. Ends by publishing
         /integrated/raw (two per-class values, see
         game_controller/README.md). Modeled on
         ros2neuro_decoder_py/launch/example_decoder.launch.xml.

         Included by evaluation.launch.py, not meant to be launched on its
         own. See calibration_pipeline.launch.xml (no classifier needed) and
         asyncronous.launch.xml (same chain, for the live async control
         path) for the other two variants.
    -->
    <arg name="decoder_model_path" default="/home/paolo/Cortical_Peaks_Challenge_2026/scripts/outputs/eegnet_mi_paolo10"/>

    <include file="$(find-pkg-share launchers_bci)/launch/gtec/acquisition_gtec.launch.xml">
    </include>

    <include file="$(find-pkg-share launchers_bci)/launch/gtec/filters_gtec.launch.xml">
    </include>

    <node pkg="ros2neuro_processing_buffer" exec="buffer_node" name="buffer" output="screen">
        <param name="sensor_name" value="EEG"/>
        <param name="buffer_samples" value="512"/>
        <remap from="/neurodata_filtered" to="/processing/filtered"/>
        <remap from="/features" to="/processing/buffered_features"/>
    </node>

    <node pkg="ros2neuro_decoder_py" exec="decoder_node" name="decoder" output="screen">
        <param name="decoder.type" value="braindecode"/>
        <param name="decoder.model_path" value="$(var decoder_model_path)"/>
        <param name="decoder.name" value="eegnet_bhbf"/>
        <remap from="/features" to="/processing/buffered_features"/>
        <remap from="~/prediction" to="/classification/prediction"/>
    </node>

    <node pkg="ros2neuro_integrator" exec="integrator_node" name="integrator" output="screen">
        <param name="input_topic" value="/classification/prediction"/>
        <param name="output_topic" value="/integrated/raw"/>
        <param name="integrator.name" value="mi_buffer_integrator"/>
        <param name="integrator.type" value="ros2neuro::integrator::Buffer"/>
        <param name="integrator.params.buffer_size" value="256"/>
        <param name="integrator.params.increment" value="1"/>
        <param name="integrator.reset_event" value="781"/>
    </node>
</launch>
